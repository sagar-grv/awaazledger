# -------------------------------------------------------------
# AwaazLedger Real Mode Environment Configuration
# Copy this file to .env.real and update with your actual credentials.
# -------------------------------------------------------------

PROJECT_NAME=AwaazLedger
VERSION=0.1.0
API_V1_STR=/api/v1
DATABASE_URL=sqlite:////app/data/awaazledger.db
SECRET_KEY=paytm_hackathon_super_secret_real_mode_2026

# WhatsApp Channel Mode (evolution, simulator)
WHATSAPP_MODE=evolution
ENABLE_EVOLUTION_LIVE=true
EVOLUTION_SERVER_URL=http://localhost:8080
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=awaazledger_secret_token_12345
EVOLUTION_INSTANCE_NAME=paytm-awaazledger
EVOLUTION_WEBHOOK_URL=http://backend:8000/api/v1/webhooks/whatsapp
EVOLUTION_WEBHOOK_EVENTS=messages.upsert
EVOLUTION_ENABLE_BASE64_MEDIA=true

# Sarvam AI STT & TTS
ENABLE_SARVAM_REAL=true
SARVAM_API_KEY=your_actual_sarvam_key
SARVAM_STT_ENDPOINT=https://api.sarvam.ai/speech-to-text
SARVAM_TTS_ENDPOINT=https://api.sarvam.ai/text-to-speech
SARVAM_LANGUAGE_HINT=hi

# Vision & OCR
ENABLE_OCR_REAL=true
OCR_ENGINE=tesseract

# Voice Reply & Visual Tracker
ENABLE_WHATSAPP_VOICE_REPLY=false
ENABLE_TRACKER_IMAGE=false

# Public URLs for WhatsApp Linkbacks
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_BACKEND_URL=http://localhost:8000

# Feedback Configuration
FEEDBACK_ENABLED=true
FEEDBACK_EXPIRY_MINUTES=30

# Live Auto-Refresh Cadence
DASHBOARD_AUTO_REFRESH_SECONDS=5
METRICS_AUTO_REFRESH_SECONDS=10

# Real WhatsApp Sender Number for Auto-Mapping (e.g. +919876543210)
DEMO_WHATSAPP_NUMBER=+919876543210

# Policy Guardrails
AUTO_CREDIT_CEILING=2000.0
MIN_TRUST_SCORE=85
MAX_FRAUD_SCORE=30
DUPLICATE_WINDOW_SECONDS=120
RBI_DELAY_PER_DAY_PENALTY=100.0

# Differentiator Features
ENABLE_SWARM_SHIELD=true
SWARM_SHIELD_WINDOW_MINUTES=5
SWARM_SHIELD_THRESHOLD=3
ENABLE_MERCHANT_RECOVERY=true
DEMO_MODE=true
