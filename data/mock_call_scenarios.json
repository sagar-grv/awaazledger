          "caller_action": "Explain issue with UTR",
          "caller_speech": "भैया शर्मा किराना पर 450 रुपये कट गए पर दुकानदार को नहीं मिला। यूटीआर 987654321012 है।",
          "expected_state": "COLLECT_FEEDBACK",
          "expected_decision": "AUTO_CREDIT",
          "expected_amount": 450.0
        },
        {
          "step": 3,
          "caller_action": "Feedback",
          "caller_speech": "बहुत बढ़िया, तुरंत पैसे आ गए। शुक्रिया।",
          "dtmf": "1",
          "expected_state": "ENDED"
        }
      ]
    },
