PROJECT_NAME="AwaazLedger"
VERSION="0.1.0"
API_V1_STR="/api/v1"
DATABASE_URL="sqlite:///./awaazledger.db"
SECRET_KEY="dev_secret_key_hackathon_only"

# -------------------------
# Real WhatsApp + Sarvam Mode
# -------------------------
WHATSAPP_MODE=evolution
ENABLE_EVOLUTION_LIVE=true
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=change-this-evolution-key
EVOLUTION_INSTANCE_NAME=paytm-awaazledger
EVOLUTION_WEBHOOK_URL=http://backend:8000/api/v1/webhooks/whatsapp
EVOLUTION_WEBHOOK_EVENTS=messages.upsert
EVOLUTION_ENABLE_BASE64_MEDIA=true

ENABLE_SARVAM_REAL=true
SARVAM_API_KEY=your-sarvam-api-key
SARVAM_STT_ENDPOINT=https://api.sarvam.ai/v1/speech-to-text
SARVAM_TTS_ENDPOINT=https://api.sarvam.ai/v1/text-to-speech
SARVAM_LANGUAGE_HINT=hi

ENABLE_OCR_REAL=true
OCR_ENGINE=tesseract

ENABLE_WHATSAPP_VOICE_REPLY=false
ENABLE_TRACKER_IMAGE=false

PUBLIC_APP_URL=http://localhost:5173
PUBLIC_BACKEND_URL=http://localhost:8000

FEEDBACK_ENABLED=true
FEEDBACK_EXPIRY_MINUTES=30

DASHBOARD_AUTO_REFRESH_SECONDS=5
METRICS_AUTO_REFRESH_SECONDS=10

DEMO_WHATSAPP_NUMBER=+919876543210

# Policy Engine Defaults
AUTO_CREDIT_CEILING=2000.0
MIN_TRUST_SCORE=85
MAX_FRAUD_SCORE=30
DUPLICATE_WINDOW_SECONDS=120
RBI_DELAY_PER_DAY_PENALTY=100.0

# Differentiator Features
ENABLE_SWARM_SHIELD=true
SWARM_SHIELD_WINDOW_MINUTES=5
SWARM_SHIELD_THRESHOLD=3
ENABLE_MERCHANT_RECOVERY=true
DEMO_MODE=true
