PROJECT_NAME="AwaazLedger"
VERSION="0.1.0"
API_V1_STR="/api/v1"
DATABASE_URL="sqlite:///./awaazledger.db"
SECRET_KEY="dev_secret_key_hackathon_only"

# Sarvam AI STT & TTS (Optional - Defaults to safe mock fallback)
SARVAM_API_KEY=""
ENABLE_SARVAM_REAL=false
SARVAM_STT_ENDPOINT="https://api.sarvam.ai/speech-to-text"
SARVAM_TTS_ENDPOINT="https://api.sarvam.ai/text-to-speech"

# OCR Engine (Optional - Defaults to deterministic mock OCR)
ENABLE_OCR_REAL=false

# WhatsApp Evolution API (Optional - Defaults to Simulator)
ENABLE_EVOLUTION_LIVE=false
EVOLUTION_API_KEY=""
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_INSTANCE_NAME="paytm-awaazledger"

# Policy Engine Defaults
AUTO_CREDIT_CEILING=2000.0
MIN_TRUST_SCORE=85
MAX_FRAUD_SCORE=30
DUPLICATE_WINDOW_SECONDS=120
RBI_DELAY_PER_DAY_PENALTY=100.0

# Differentiator Features
ENABLE_SWARM_SHIELD=true
SWARM_SHIELD_WINDOW_MINUTES=5
SWARM_SHIELD_THRESHOLD=3
ENABLE_MERCHANT_RECOVERY=true
DEMO_MODE=true
